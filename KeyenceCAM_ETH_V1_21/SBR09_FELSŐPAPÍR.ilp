(*2*)
(* Network 0 *)
(****** FELSÕ PAPÍRADAGOLÓ ******)
LD    %I3.7
ST   onoff
(* Network 1 *)
LD    %I3.6
ST   manual
(* Network 2 *)
LD    %I3.5
ST   korongsens
(* Network 3 *)
LD    %I3.4
ST   mhalap
(* Network 4 *)
LD    adagolas
ORN    korongsens
AND    A_run
ANDN    hiba
OR    manual
ST   Qmot
(* Network 5 *)
LD    korongsens
R_TRIG
OR(
LD    korongerk
AND    mhalap
)
ST   korongerk
(* Network 6 *)
LD    mhalap
R_TRIG
OR(
LD    adagolas
ANDN    korongerk
)
AND    A_run
ST   adagolas
(* Network 7 *)
LD    korongsens
F_TRIG
OR(
LD    leadva
AND    mhalap
)
ST   leadva
(* Network 8 *)
LD    A_run
AND(
LDN    korongsens
OR    adagolas
)
ANDN    hiba
TON   T37, 40
__CR_EQ_1
MOVE    T37, t_37
__CR_RESTORE
ST   %BR0.0
(* Network 9 *)
(*Indítás / leállítás*)
LD    onoff
ANDN    hiba
OR    A_run
ANDN    A_stop
ST   A_run
(* Network 10 *)
LD    A_run
AND(
LDN    onoff
OR    A_koztes
)
ST   A_koztes
(* Network 11 *)
LD    A_koztes
OR    A_stop
AND    onoff
ANDN    hiba
ST   A_stop
(* Network 12 *)
LD    onoff
F_TRIG
ST   offoff
(* Network 13 *)
LD    A_run
AND(
LD    T37
OR(
LD    hiba
ANDN    offoff
)
)
ST   hiba
(* Network 14 *)
LD    A_run
AND    mhalap
AND    leadva
AND    korongerk
ANDN    hiba
R_TRIG
OR(
LD    mhveg_mehet
AND    mhalap
)
ST   mhveg_mehet
(* Network 15 *)
LDN    A_run
AND    mhalap
OR    mhveg_mehet
ST   Qmhveg
(* Network 16 *)
LD    A_run
R_TRIG
R    blink
(* Network 17 *)
LD    hiba
ANDN    T38
TOF   T38, 2
__CR_EQ_1
MOVE    T38, t_38
__CR_RESTORE
ST   %BR0.0
(* Network 18 *)
LD    hiba
AND    T38
ALT    blink
(* Network 19 *)
LD    blink
OR(
LD    A_run
ANDN    hiba
)
ST   Qled
(* Network 20 *)
LD    Qled
ST   %Q3.4
(* Network 21 *)
LD    Qmot
ST   %Q3.5
(* Network 22 *)
LD    Qmhveg
ST   %Q3.6
