(*2*)
(* Network 0 *)
(*Nincs iránykimenet, Q0.2 így általános kimenetként mûködik*)
LD    %SM0.1
S    %SM201.3
S    %SM231.3
S    %M31.6
(* Network 1 *)
LD    TRUE
PREL    0, MOTSTART, %VW250, %VD252, %VW256, %VD258, %M31.7, %M32.1, %MB33
PREL    1, MOTSTART, %VW250, %VD252, %VW256, %VD262, %M32.3, %M32.4, %MB34
R    %M31.6
(* Network 2 *)
(*Automata pörgetés teszteléshez, HMI-rõl aktiválva*)
LDN    T13
TON   T13, spintime
__CR_EQ_1
MOVE    T13, %VW364
__CR_RESTORE
ST   %BR0.0
(* Network 3 *)
(*Automata pörgetés teszteléshez, HMI-rõl aktiválvaIN_SPIRAL indította korábban, de T2-re lett módosítva, hogy késleltetni lehessen a biztos csomag beérkezés miatt*)
LD    %M35.0
AND    T13
OR(
LD    %M201.7
AND    T2
OR(
LDN    %M201.7
AND    %M150.0
)
R_TRIG
)
S    %M31.6
(* Network 4 *)
LD    %M53.7
OR(
LD    IN_homing
ANDN    FIN_jogtoorigin
)
ST   IN_homing
(* Network 5 *)
LD    IN_homing
R_TRIG
R    DONE0
R    DONE02
R    DONE1
R    DONE12
(* Network 6 *)
(*HOME pozíció keresése*)
LD    IN_homing
ANDN    FIN_findhome
ST   IN_findhome
(* Network 7 *)
(*HOME pozíció keresése*)
LD    IN_homing
AND    IN_findhome
AND    DONE0
AND    DONE1
R_TRIG
OR(
LD    IN_homing
AND    FIN_findhome
)
ST   FIN_findhome
(* Network 8 *)
(*HOME->ORIGIN*)
LD    IN_homing
AND    FIN_findhome
ANDN    FIN_jogtoorigin
ST   IN_jogtoorigin
(* Network 9 *)
(*HOME->ORIGIN*)
LD    IN_homing
AND    IN_jogtoorigin
AND    DONE02
AND    DONE12
R_TRIG
OR(
LD    IN_homing
AND    FIN_jogtoorigin
)
ST   FIN_jogtoorigin
(* Network 10 *)
LD    %I1.0
R_TRIG
ST   HOMET0
(* Network 11 *)
(*IDE kell választani egy bemenetet, ahova beérkezik a második motor nullpont érzékelõje*)
LD    %I0.7
R_TRIG
ST   HOMET1
(* Network 12 *)
(*Nullpont keresés spirál motor*)
LD    TRUE
PHOME    0, IN_findhome, HOMET0, HOMET0, I#1, I#1, W#200, DW#1000, W#50, DONE0, ERR, ERRID
PHOME    1, IN_findhome, HOMET1, HOMET1, I#1, I#1, W#200, DW#1000, W#50, DONE1, ERR, ERRID
(* Network 13 *)
(*kezdõ pozíció felvétele a nullponttól számítva negyed fordulat*)
LD    TRUE
PREL    0, IN_jogtoorigin, W#200, DW#1000, W#500, DI#35, DONE02, ERR2, ERRID2
PREL    1, IN_jogtoorigin, W#200, DW#1000, W#500, DI#35, DONE12, ERR2, ERRID2
(* Network 14 *)
(*Egalizáló tallér szállító szalagAxis 2 -> Q0.4 kimenetre*)
LD    TRUE
PJOG    2, motor2, DW#600, I#0, DONE3, ERR3, ERRID3
