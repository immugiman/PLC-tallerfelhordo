(*2*)
(* Network 0 *)
(*HSC_PULSE a 10mm-eket számlálja.VW2700-ba pakolja a spirálba fogadásra váró csomag darabszámát.5  megszakításig várakozik, majd nullázza a VW2700-at, és a HIANYZO bitet magasra állítja.*)
LD    %SM0.0
MOVE    B#16#C0, %SMB37
MOVE    DI#0, %SMD38
MOVE    I#0, NULLA
HSC    0
(* Network 1 *)
LD    %SM0.0
ANDN    %M53.4
WSFL    NULLA, SZALAGMEMO, 61, 1
(* Network 2 *)
LD    %SM0.0
AND    %M53.4
WSFL    ATADO, SZALAGMEMO, 61, 1
R    %M53.4
(* Network 3 *)
(*Spirálba átadásra vár*)
LD    %SM0.0
GT    %VW2720, I#0
MOVE    %VW2720, ÁTADNIVALO
MOVE    W#0, %VW2720
MOVE    B#0, VARAKOZAS
S    %M35.5
(* Network 4 *)
(**** Bekerült a végére, hogy VARATVETELRE törlés,. és a SET HIANYZO  kikerült onnan, mert nem használom*)
LD    %M35.5
INC    VARAKOZAS
GT    VARAKOZAS, %VB624
MOVE    I#0, ÁTADNIVALO
R    %M35.5
(* Network 5 *)
(*Kilökési pozi betöltése. Ha 8cm-nél kisebb a tallér hossza, akkor a kilökési pontot növelni kell 1cm-rel, hogy akkor is középen érje a légáramlat.*)
LD    %SM0.0
MOVE    &VW2600, %VD614
ADD    kilokes, %VD614
OR(
LD    FALSE
LT    utolsohossz, I#9
INC    %VD614
INC    %VD614
)
(* Network 6 *)
(*Pozi növelése, és ha kifúvási pozícióba kerül, akkor flag állítása*)
LD    %SM0.0
AND(
LD    %M30.5
EQ    *VD614, I#1
OR(
LD    TRUE
EQ    *VD614, I#10
)
)
R_TRIG
S    %M30.4
(* Network 7 *)
LD    %M53.5
INC    csomhossz
