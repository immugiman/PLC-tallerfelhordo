(*2*)
(* Network 0 *)
(*Védett memóriatartományok:VD5000 - VD5007 CMPBLK részére foglalvaVD2536, VD2540 POINTER-ek*)
LD    %SM0.1
MOVE    0, NULL
MOVE    10, _INT
MOVE    DI#0, _DINT
FIFO_INIT
MOVE    DI#10, %SMD16
ATCH    INT01, 4
(* Network 1 *)
LD    %SM0.1
MOVE    B#0, ZERO
MOVE    I#0, emptyfifo_cnt
S    %M201.1
S    %M201.2
S    %M201.3
(* Network 2 *)
(*Bemenetek beolvasása*)
LD    TRUE
CAL    SBR07
CAL    SBR05
CAL    SBR09
(* Network 3 *)
LD    TRUE
CAL    SBR01    _CAM1RES, _CAM1JNR, _CAM1ONLINE, CAM1ERROR
(* Network 4 *)
LD    TRUE
CAL    SBR04    CAM2ERROR, _CAM2RES, _CAM2JNR, _CAM2ONLINE
(* Network 5 *)
(*Egalizáló, és SPIRÁL MOTOR VEZÉRLÉSE*)
LD    TRUE
CAL    SBR02
CAL    SBR06
(* Network 6 *)
(*Automatikus trigger idõzítõje, a HMI-n beállított ciklusidõvelTeszteléshez*)
LDN    T5
TON   T5, %VW30
(* Network 7 *)
(*Válaszídõ számláló indítása*)
LD    %I0.3
AND    %I1.3
AND    %M20.0
TON   T1, 10000
__CR_EQ_1
MOVE    T1, PROCTimer
__CR_RESTORE
ST   %BR0.0
(* Network 8 *)
(*Trigger feltételek, és fotózás indítása a kamerák trigger bemenetének aktiválása*)
LD    %I0.3
AND    %I1.3
AND    _CAM1ONLINE
AND    _CAM2ONLINE
ANDN    %I0.2
ANDN    %I1.2
ANDN    %M10.1
AND(
LD    T11
ORN    %M20.0
)
AND(
LD    %M10.0
OR    C1
OR(
LD    %M20.1
AND    T5
)
)
R_TRIG
R    _CAMTRIGGERED
ST   _OTRIG
S    %M20.0
(* Network 9 *)
(*Trigger kimenet a kamera felé kitartva 10ms-ig*)
LD    _OTRIG
TOF   T12, 1
__CR_EQ_1
MOVE    T12, trigkitart
__CR_RESTORE
ST   %Q1.0
ST   %Q1.2
(* Network 10 *)
(*Ha a kamera leáll valami miatt, akkor az újraindítás utána a COMMTIME törölve lesz, hogy ne ragadjon be a kiértékelés*)
LD    %I0.3
AND    %I1.3
R_TRIG
R    %M20.0
(* Network 11 *)
(*Trigger jel kimaszkolása, ha 180ms-on belül érkezne újabbElõzõ trigger óta eltelt idõ mentése regiszterbe*)
LD    %M20.0
AND(
LD    TRUE
TON   T11, TMASKTIME
__CR_EQ_1
MOVE    T11, masktimer
__CR_RESTORE
OR(
LD    TRUE
R_TRIG
MOVE    Time_TRIG, %VW306
MUL    W#10, %VW306
)
)
(* Network 12 *)
(*Kamera triggerelés után, amennyiben 100ms-on belül nem vált magasra a BUSY jel,akkor feltételezhetõ, hogy a kamera nem kapta meg a trigger jelet.*)
LD    %I0.2
AND    %I1.2
R_TRIG
S    %M31.4
(* Network 13 *)
(*Kamera triggerelés után, amennyiben 100ms-on belül nem vált magasra a BUSY jel,akkor feltételezhetõ, hogy a kamera nem kapta meg a trigger jelet.*)
LDN    %M31.4
AND    %M20.0
GT    PROCTimer, 100
R_TRIG
INC    TRIGTOUT
(* Network 14 *)
(*Triggerek közt eltelt idõ számolása*)
LDN    %Q1.0
TON   T6, 1000
__CR_EQ_1
MOVE    T6, Time_TRIG
__CR_RESTORE
ST   %BR0.0
(* Network 15 *)
(*Ha a kamera kiértékelési sorszáma változott az elõzõhöz képest, akkor mentem az eredményt, és update-elem a sroszámot, process time-ot, valamint az összesítõhöz hozzáadom a db-számot.Network 15, 16, 17, 18 A kamerák eredményeit dolgozzák fel, és a pufferba helyezik sorrendben:1. kamera, 2. kamera*)
LDN    %M40.0
NE    _CAM1_LASTNR, _CAM1JNR
MOVE    _CAM1JNR, _CAM1_LASTNR
MOVE    _CAM1JNR, CAM1JNR
MOVE    _CAM1RES, CAM1RES
ADD    _CAM1RES, SUMCOUNT
MOVE    PROCTimer, Time_TOTAL
R_TRIG
S    %M31.1
(* Network 16 *)
(*Ha a kamera kiértékelési sorszáma változott az elõzõhöz képest, akkor mentem az eredményt, és update-elem a sroszámot, process time-ot, valamint az összesítõhöz hozzáadom a db-számot.*)
LDN    %M40.1
NE    _CAM2_LASTNR, _CAM2JNR
MOVE    _CAM2JNR, _CAM2_LASTNR
MOVE    _CAM2JNR, CAM2JNR
MOVE    _CAM2RES, CAM2RES
ADD    _CAM2RES, SUMCOUNT
MOVE    PROCTimer, Time_TOTAL
R_TRIG
S    %M31.2
(* Network 17 *)
LD    %M31.1
R_TRIG
AND(
LD    TRUE
GT    _CAM1RES, 0
MOVE    B#0, ZERO
FIFO_PUSH    _CAM1RES
OR(
LD    TRUE
EQ    _CAM1RES, 0
AND(
LD    TRUE
INC    ZERO
GT    ZERO, B#3
R_TRIG
FIFO_INIT
OR(
LD    TRUE
NOP    0
)
)
)
)
R    %M31.1
S    %M31.3
(* Network 18 *)
(*A veremben a sorrend megtartása miatt, a 2-es kamera csak az egyes után tolhatja be az értéket*)
LD    %M31.3
AND    %M31.2
R_TRIG
AND(
LD    TRUE
GT    _CAM2RES, 0
MOVE    B#0, ZERO
FIFO_PUSH    _CAM2RES
OR(
LD    TRUE
EQ    _CAM2RES, 0
AND(
LD    TRUE
INC    ZERO
GT    ZERO, B#3
R_TRIG
FIFO_INIT
OR(
LD    TRUE
NOP    0
)
)
)
)
R    %M31.2
R    %M31.3
R    %M20.0
(* Network 19 *)
LD    %SM0.0
FIFO_SIZE    _FIFOSIZE
AND(
LD    %SM0.0
GT    _FIFOSIZE, MAXFIFO
MOVE    _FIFOSIZE, MAXFIFO
OR(
LDN    %SM0.0
GT    _FIFOSIZE, 7
MOVE    0, MAXFIFO
FIFO_INIT
)
)
(* Network 20 *)
(*##### ÁTVÉTEL A SÍMA SZALAGRA #####*)
LD    %M30.3
R_TRIG
FIFO_SIZE    _FIFOSIZE
AND(
LD    TRUE
GT    _FIFOSIZE, 0
FIFO_POP    1, ATADO, _POPSIZE
OR(
LD    TRUE
EQ    _FIFOSIZE, 0
INC    emptyfifo_cnt
MOVE    0, ATADO
)
)
S    %M53.4
(* Network 21 *)
LD    %M53.5
F_TRIG
MOVE    csomhossz, utolsohossz
MOVE    I#0, csomhossz
GT    utolsohossz, maxhossz
INC    tulmeretesek
(* Network 22 *)
(*##### LEDOBÁS SPIRÁLBA #####Itt azt is ellenõrizhetjük, hogy az utolsó elem valóban elérhette az spirál érzékelõjét.*)
LD    %M52.0
AND    %M35.5
MOVE    SPIRALON, LEDOBVA
MOVE    ÁTADNIVALO, SPIRALON
MOVE    I#0, ÁTADNIVALO
R    %M35.5
(* Network 23 *)
(*TESZT üzemmódban, ellenõrizni kell, hogy a kiadott darabszám, plusz a spirálon lévõ mennyiség nagyobb-e mint a megkívánt mennyiség. Ha igen, akkor blende zár.*** bekerült a LEADAS kontakt*)
LD    FALSE
AND    %M52.0
MOVE    SUMOUT, KONTROLL
ADD    LEDOBVA, KONTROLL
GT    KONTROLL, IGÉNY
OR(
LD    FALSE
AND    %M300.0
ANDN    %M200.3
)
ST   %M300.0
(* Network 24 *)
LD    FALSE
AND    %M300.0
ST   %M100.3
(* Network 25 *)
LD    %M52.0
AND(
LDN    %M300.0
ORN    %M52.1
ADD    LEDOBVA, SUMOUT
OR(
LD    %M300.0
OR    %M52.1
ADD    LEDOBVA, BLENDEN
)
)
(* Network 26 *)
LD    %M52.1
F_TRIG
OR    %M40.6
MOVE    0, BLENDEN
(* Network 27 *)
LD    TRUE
GT    BLENDEN, 15
ST   %M200.5
(* Network 28 *)
(*#### KIFÚJÁS ####1 db-os tallér csomag kifújása egalizátorhoz*)
LD    %M30.4
R_TRIG
S    %M30.6
(* Network 29 *)
(*#### KIFÚJÁS ####*)
LD    %M30.4
TON   T30, 4
__CR_EQ_1
MOVE    T30, atblowtimer
__CR_RESTORE
R    %M30.4
(* Network 30 *)
(*#### KIFÚJÁS ####1 db-os tallér csomag kifújása egalizátorhoz*)
LD    %M30.6
TON   T24, blowdura
__CR_EQ_1
MOVE    T24, blowtimer
__CR_RESTORE
R    %M30.6
(* Network 31 *)
(*Minden nulláz*)
LD    %M50.5
R_TRIG
MOVE    0, SPIRALON
MOVE    0, BLENDEN
ST   %M30.1
S    %M31.6
(* Network 32 *)
(*Tallér összesítõ nullázása*)
LD    %M30.1
MOVE    0, SUMCOUNT
MOVE    0, SUMOUT
(* Network 33 *)
LD    %M31.0
MOVE    0, TRIGTOUT
(* Network 34 *)
LD    %M31.5
R_TRIG
FIFO_INIT
(* Network 35 *)
(*PLC Scantime betöltése*)
LD    %SM0.0
MOVE    %SMB6, scantime
(* Network 36 *)
(*VIBRAMOTOR indítás/leállítás*)
LD    %M50.3
AND    %M40.2
R_TRIG
S    %M50.4
(* Network 37 *)
(*VIBRAMOTOR indítás/leállítás*)
LDN    %M50.3
ORN    %M40.2
TON   T39, I#1000
__CR_EQ_1
MOVE    T39, _t39
__CR_RESTORE
ST   %BR0.0
(* Network 38 *)
(*VIBRAMOTOR indítás/leállítás*)
LDN    %M40.6
AND    T39
R_TRIG
R    %M50.4
(* Network 39 *)
(*Idõszakos homing-olása a spiralmotornak*)
LD    %M30.3
OR(
LD    _lastpush
ANDN    %M30.3
)
(* Network 40 *)
(*Idõszakos homing-olás*)
LDN    %M30.3
TON   T44, 10
__CR_EQ_1
MOVE    T44, _t44
__CR_RESTORE
ST   %BR0.0
(* Network 41 *)
(*Idõszakos homing-olás*)
LD    %M201.2
AND    %M50.3
ANDN    _homing
TON   T41, homeinterval
__CR_EQ_1
MOVE    T41, _t41
__CR_RESTORE
ST   %M54.0
(* Network 42 *)
(*Idõszakos homing-olás*)
LD    %M54.0
AND    T44
R_TRIG
OR(
LD    _homing
ANDN    T43
)
ST   _homing
(* Network 43 *)
(*Idõszakos homing-olás*)
LD    _homing
R_TRIG
ST   %M53.7
(* Network 44 *)
(*Idõszakos homing-olásHoming generál egy leadást*)
LD    _homing
TON   T42, 5
__CR_EQ_1
MOVE    T42, _t42
__CR_RESTORE
R_TRIG
OR(
LD    %M54.1
ANDN    T43
)
ST   %M54.1
(* Network 45 *)
(*Spirálból sumout-ba, vagy belndébe kerül a spirálon lévõ tallérszám, nullázás és homing következtében.*)
LD    %M54.1
TON   T43, 1
__CR_EQ_1
MOVE    T43, _t43
__CR_RESTORE
OR    %M50.5
AND(
LDN    %M52.1
ADD    SPIRALON, SUMOUT
OR(
LD    %M52.1
ADD    SPIRALON, BLENDEN
)
)
MOVE    0, SPIRALON
(* Network 46 *)
LD    TRUE
CAL    SBR10
CAL    SBR08
