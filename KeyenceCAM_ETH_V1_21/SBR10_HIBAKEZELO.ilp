(*2*)
(* Network 0 *)
(*Ezek a hibák a csomagológépen is hibát generálnak*)
LDN    %M40.0
ANDN    %M40.1
ANDN    %M200.7
ANDN    %M201.5
AND(
LDN    %M400.0
ORN    %M201.3
)
ST   %M40.2
(* Network 1 *)
(*Ezek a torlódás lámpát kapcsolják a szalag HMI-n*)
