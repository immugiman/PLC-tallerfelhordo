(*2*)
(* Network 0 *)
(****** ALSÓ PAPÍRADAGOLÓ ******)
LD    %I3.7
ST   onoff
(* Network 1 *)
LD    %I3.6
ST   manual
(* Network 2 *)
LD    %I3.5
ST   korongsens
(* Network 3 *)
LD    %I3.4
ST   mhalap
(* Network 4 *)
LD    adagolas
ORN    korongsens
AND    A_run
OR    manual
ST   Qmot
(* Network 5 *)
LD    mhalap
R_TRIG
AND    korongsens
OR(
LD    adagolas
AND    korongsens
)
AND    A_run
ST   adagolas
(* Network 6 *)
LD    A_run
ANDN    korongsens
ANDN    hiba
TON   T37, 40
__CR_EQ_1
MOVE    T37, t_37
__CR_RESTORE
ST   %BR0.0
(* Network 7 *)
LD    A_run
AND(
LD    T37
OR(
LD    hiba
ANDN    onoff
)
)
ST   hiba
(* Network 8 *)
(*Indítás / leállítás*)
LD    onoff
OR    A_run
ANDN    A_stop
ANDN    hiba
ST   A_run
(* Network 9 *)
LD    A_run
AND(
LDN    onoff
OR    A_koztes
)
ST   A_koztes
(* Network 10 *)
LD    A_koztes
OR    A_stop
AND    onoff
ST   A_stop
(* Network 11 *)
LD    A_run
R_TRIG
R    blink
(* Network 12 *)
LD    hiba
ANDN    T38
TOF   T38, 2
__CR_EQ_1
MOVE    T38, t_38
__CR_RESTORE
ST   %BR0.0
(* Network 13 *)
LD    hiba
AND    T38
ALT    blink
(* Network 14 *)
LD    blink
OR    A_run
ST   Qled
(* Network 15 *)
LD    Qled
ST   %Q3.4
(* Network 16 *)
LD    Qmot
ST   %Q3.5
(* Network 17 *)
LD    Qmhveg
ST   %Q0.6
