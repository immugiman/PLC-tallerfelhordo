(*2*)
(* Network 0 *)
LD    %I0.4
AND    %M50.3
ANDN    %M54.2
R_TRIG
ST   _IN_TRIG
(* Network 1 *)
(*Minden második triggerre fotózunk*)
LD    _IN_TRIG
AND(
LD    TRUE
CTU   C1, C1, 2
__CR_EQ_1
MOVE    C1, count
__CR_RESTORE
OR(
LD    TRUE
WSFL    ZEROW, %VW2800, 10, 1
)
)
(* Network 2 *)
(*Trigger jelet 160ms-ig kimaszkolni*)
LD    _IN_TRIG
OR(
LD    %M54.2
ANDN    T8
)
ST   %M54.2
(* Network 3 *)
(*Trigger és PUSH közti idõkülönbség méréséhez*)
LD    _IN_TRIG
R_TRIG
OR(
LD    _tr_to_pu
ANDN    %M30.3
)
ST   _tr_to_pu
(* Network 4 *)
(*Trigger to PUSH delta T mérése, és kijelzése*)
LD    _tr_to_pu
MOVE    _t9, TtoPDelta
TON   T9, 100
__CR_EQ_1
MOVE    T9, _t9
__CR_RESTORE
ST   %BR0.0
(* Network 5 *)
LD    _tr_to_pu
F_TRIG
MOVE    TtoPDelta, lastTtP
(* Network 6 *)
(*Trigger mask timer*)
LD    %M54.2
TON   T8, 16
__CR_EQ_1
MOVE    T8, _t8
__CR_RESTORE
ST   %BR0.0
(* Network 7 *)
(*Ha nem megy a szalag, akkor ne pörgessen*)
LD    %I0.5
AND    %M50.3
ST   %M150.0
(* Network 8 *)
(*2-õt  ÁTADNIVALO-ba töltök, hogy elkoszosodott PUSH érzékelõ esetén is adjon le a csomagolónak valamit, hogy ne legyen torlódás3 üres spin után hiba10 érvényes spin után emptyspin csökkentve 1-gyel.*)
LD    %M150.0
R_TRIG
AND(
LD    %M35.5
INC    okspin
AND(
LD    TRUE
OR(
LD    TRUE
GT    okspin, I#10
GT    emptyspin, I#0
DEC    emptyspin
)
)
OR(
LDN    %M35.5
MOVE    I#2, ÁTADNIVALO
MOVE    I#0, okspin
INC    emptyspin
)
)
ST   %M52.0
(* Network 9 *)
LD    %M150.0
TON   T7, 10
__CR_EQ_1
MOVE    T7, t_spintrig
__CR_RESTORE
ST   %M200.7
(* Network 10 *)
LD    %I0.6
R_TRIG
ST   %M30.3
(* Network 11 *)
LD    %I0.6
F_TRIG
ST   %M53.6
(* Network 12 *)
LD    %M30.3
OR(
LD    %M53.5
ANDN    %M53.6
)
ST   %M53.5
(* Network 13 *)
(*Átfújt tallér megérkezett*)
LD    %I1.4
ST   %M36.0
(* Network 14 *)
LD    %M36.0
TON   T28, 3
__CR_EQ_1
MOVE    T28, %LW60
__CR_RESTORE
ST   %M36.2
(* Network 15 *)
(*Egalizáló szalag végén áll egy tallér*)
LD    %I1.5
ST   %M36.1
(* Network 16 *)
LD    %M36.1
TON   T29, 1
__CR_EQ_1
MOVE    T29, %LW58
__CR_RESTORE
ST   %M36.3
(* Network 17 *)
LD    %I2.3
ANDN    %M40.6
AND    %M201.1
OR(
LD    %M40.6
AND    %M201.0
)
ANDN    %M400.0
ST   %M50.3
(* Network 18 *)
LD    %I2.0
ANDN    %M40.6
ST   %M200.0
(* Network 19 *)
LD    %I2.1
ANDN    %M40.6
ST   %M52.1
(* Network 20 *)
LDN    %I1.6
TON   T46, I#10
__CR_EQ_1
MOVE    T46, %LW194
__CR_RESTORE
ST   %L184.5
(* Network 21 *)
LD    %I1.6
TON   T45, I#10
__CR_EQ_1
MOVE    T45, %LW188
__CR_RESTORE
ST   %L184.4
(* Network 22 *)
LD    %L184.4
OR(
LD    %M40.7
ANDN    %L184.5
)
ST   %M40.7
